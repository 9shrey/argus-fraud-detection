# Copy to .env and adjust. All values here have working defaults in
# app/config.py — you only need this file to override them.

# Defaults to a local SQLite file (zero setup). Point at Postgres for
# docker-compose / production:
# DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus
DATABASE_URL=sqlite:///./argus.db

# Risk score (0-100) at/above which a scored transaction becomes an Alert.
RISK_THRESHOLD=65.0

# Simulator pacing.
SIMULATION_RATE_TPS=2.0
SIMULATION_FRAUD_RATE=0.06
SIMULATION_NUM_USERS=150

# Comma-separated frontend origin(s) allowed to call this API / connect the
# WebSocket. "*" for local dev.
CORS_ORIGINS=*
